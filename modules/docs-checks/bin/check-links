#!/usr/bin/env node
// Checks that every relative link in the Markdown docs points to a file that exists: AGENTS.md
// and every *.md under openspec/ and docs/, or the files and folders given as arguments.
// Web links, mailto: and in-page anchors are skipped; so are links inside code blocks and spans.
//
// It catches a link to a change that was archived (changes/<change>/ instead of
// changes/archive/<date>-<change>/), a diagram that was never copied into a spec, and typos.
//
// It also checks that every line in the backlog's "Working on" and "Next" still finds its item (see
// "Limitations and the backlog" in CONVENTION.md). A line `1. [Short title](…/implementation.md)` or
// `- [Short title](…/implementation.md): [change](…)` needs a bullet titled
// `**Short title**` in that page's "Limitations" section; `1. [Short title](#bugs)` needs one in the
// backlog's own section with that anchor. Titles are compared as written, code spans included,
// ignoring a trailing period.
//
//   bin/check-links                                     # everything
//   bin/check-links openspec/changes/<change>           # one change
import fs from "node:fs"
import path from "node:path"
import { fileURLToPath } from "node:url"

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..")
const LIMITATIONS = "Limitations"
const PLANNING = [ "Working on", "Next" ]
const TITLED = /^\s*[-*]\s+\*\*(.+?)\*\*/
const PLANNING_LINE = /^\s*(?:[-*]|\d+\.)\s+\[([^\]]+)\]\(\s*<?([^)\s>]+)>?\s*\)/

function markdownIn(target) {
  if (!fs.existsSync(target)) return []
  if (!fs.statSync(target).isDirectory()) return target.endsWith(".md") ? [ target ] : []

  return fs.readdirSync(target, { withFileTypes: true }).flatMap((entry) => {
    if (entry.name.startsWith(".") || entry.name === "node_modules") return []
    return markdownIn(path.join(target, entry.name))
  })
}

const withoutCodeBlocks = (text) => text.replace(/^(`{3,}|~{3,})[^\n]*\n[\s\S]*?^\1[^\n]*$/gm, "")

// Links as written, without the code that only looks like one.
function linksIn(text) {
  const prose = withoutCodeBlocks(text).replace(/(?<!\[)(`+)[^`\n]+?\1(?!\])/g, "")
  return [ ...prose.matchAll(/\]\(\s*(<[^>]*>|[^)\s]+)/g) ].map((match) => match[1].replace(/^<|>$/g, ""))
}

const normalize = (title) => title.trim().replace(/\.$/, "").trim()
const isBacklog = (file) => path.basename(file) === "backlog.md" && path.basename(path.dirname(file)) === "docs"
const isFeaturePage = (file) => path.basename(file) === "implementation.md"
const anchor = (heading) => heading.trim().toLowerCase().replace(/[^\p{L}\p{N}\s-]/gu, "").replace(/\s/g, "-")

// The "## " sections of a file, outside code blocks: Map(anchor => { heading, lines }).
const sectionCache = new Map()
function sections(file) {
  if (!sectionCache.has(file)) {
    const found = new Map()
    let current = null
    for (const line of withoutCodeBlocks(fs.readFileSync(file, "utf8")).split("\n")) {
      const heading = line.match(/^## (.+?)\s*$/)
      if (heading) found.set(anchor(heading[1]), (current = { heading: heading[1], lines: [] }))
      else current?.lines.push(line)
    }
    sectionCache.set(file, found)
  }
  return sectionCache.get(file)
}

const titlesIn = (section) => new Set((section?.lines ?? []).map((line) => line.match(TITLED)?.[1]).filter(Boolean).map(normalize))
const resolve = (from, link) => path.resolve(path.dirname(from), decodeURIComponent(link.replace(/[#?].*$/, "")))
const shown = (file) => path.relative(process.cwd(), file)

// Each line in the backlog's Working on and Next must find its item.
function unresolvedPlanning(file) {
  if (!isBacklog(file)) return []

  return PLANNING.flatMap((name) => sections(file).get(anchor(name))?.lines ?? []).flatMap((line) => {
    const match = line.match(PLANNING_LINE)
    if (!match) return []
    const [ , text, link ] = match
    const title = normalize(text)

    if (link.startsWith("#")) {
      const section = sections(file).get(link.slice(1))
      if (!section) return [ `${shown(file)}: "${title}" points to ${link}, a section the backlog doesn't have` ]
      if (titlesIn(section).has(title)) return []
      return [ `${shown(file)}: no bullet titled "${title}" under "${section.heading}"` ]
    }

    if (external.test(link)) return []
    const target = resolve(file, link)
    if (!fs.existsSync(target) || !isFeaturePage(target)) return []
    if (titlesIn(sections(target).get(anchor(LIMITATIONS))).has(title)) return []
    return [ `${shown(file)}: no limitation titled "${title}" in ${shown(target)}` ]
  })
}

const external = /^([a-z][a-z0-9+.-]*:|#)/i
const defaults = [ "AGENTS.md", "openspec", "docs" ].map((target) => path.join(root, target))
const targets = process.argv.length > 2 ? process.argv.slice(2) : defaults
const files = targets.flatMap((target) => markdownIn(path.resolve(target))).sort()

let count = 0
const broken = files.flatMap((file) => {
  const links = linksIn(fs.readFileSync(file, "utf8")).filter((link) => !external.test(link))
  count += links.length

  return links.flatMap((link) => (fs.existsSync(resolve(file, link)) ? [] : [ `${shown(file)}: ${link}` ]))
})
const untitled = files.flatMap(unresolvedPlanning)

if (broken.length > 0) console.error(`${broken.length} of ${count} links in ${files.length} files point to nothing:\n\n${broken.join("\n")}\n`)
if (untitled.length > 0) console.error(`${untitled.length} lines in the backlog's Working on and Next don't find their item:\n\n${untitled.join("\n")}\n`)
if (broken.length > 0 || untitled.length > 0) process.exit(1)

console.log(`All ${count} links in ${files.length} files resolve.`)

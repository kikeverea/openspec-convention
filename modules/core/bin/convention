#!/usr/bin/env ruby
# frozen_string_literal: true

# Keeps this project's copy of the shared convention (~/RubymineProjects/convention) in step
# with the source. Run it from the project's root.
#
#   bin/convention check              # fail if this project and the source have drifted apart
#   bin/convention sync [module ...]  # copy the source's files in (and adopt new modules)
#   bin/convention diff [path ...]    # show how this project's copies differ from the source
#   bin/convention upstream path ...  # copy files edited here back into the source
#   bin/convention archive <change>   # archive an OpenSpec change and do the mechanical follow-up
#
# convention.lock records the adopted modules, the source commit and a hash of every copied
# file, so `check` can tell the two kinds of drift apart:
#   - edited here: a project changed its copy. Move the edit to the source (upstream), commit
#     it there, then sync every project.
#   - changed in the source: run `bin/convention sync`.
# Where the source isn't checked out (CI, the server), `check` says so and passes. The source is
# found through CONVENTION_ROOT, else the project's untracked .convention file, else
# ~/RubymineProjects/convention; when sync or upstream can't find it, ask the user where it is.
require "digest"
require "fileutils"
require "pathname"
require "yaml"

module Convention
  # Where the source is on this computer: CONVENTION_ROOT, else the project's untracked
  # .convention file (one line, the folder's path), else the default.
  POINTER = ".convention"
  SOURCE = File.expand_path(
    ENV["CONVENTION_ROOT"] || (File.read(POINTER).strip if File.exist?(POINTER)).then { |path| path unless path&.empty? } ||
      "~/RubymineProjects/convention"
  )
  LOCK = "convention.lock"
  ALWAYS = %w[core].freeze

  module_function

  def run(command, args)
    case command
    when "check" then check
    when "sync" then sync(args)
    when "diff" then diff(args)
    when "upstream" then upstream(args)
    when "archive" then Archive.new(args).run
    else abort File.read(__FILE__)[/^# Keeps.*?(?=^# convention\.lock)/m].gsub(/^# ?/, "")
    end
  end

  def check
    unless File.directory?(SOURCE)
      puts "Convention source not found at #{SOURCE}; skipping the check."
      return
    end
    abort "No #{LOCK} here: adopt the convention with `#{SOURCE}/bin/convention sync <module> ...`." unless lock

    problems = drift.map { |path, state| "  #{path}: #{MESSAGES.fetch(state)}" }
    if problems.empty?
      puts "Convention is in step with the source (#{lock["modules"].join(", ")})."
    else
      abort "Convention drift (source: #{SOURCE}):\n#{problems.join("\n")}\n\n" \
            "Edited here: move the edit to the source with `bin/convention upstream <path>`, commit it there, then sync.\n" \
            "Changed in the source: run `bin/convention sync`. `bin/convention diff` shows the differences."
    end
  end

  MESSAGES = {
    edited: "edited here",
    changed: "changed in the source",
    both: "edited here and changed in the source",
    new: "new in the source",
    unrecorded: "matches the source, but sync hasn't recorded it",
    missing: "missing here",
    removed: "removed from the source"
  }.freeze

  # { "bin/check-links" => :edited, ... } for every file that isn't in step.
  def drift
    recorded = lock["files"]
    source = source_files(lock["modules"])

    states = source.to_h do |path, from|
      local = hash_of(path)
      was = recorded[path]
      state = if was.nil? then :new
      elsif local.nil? then :missing
      elsif local == hash_of(from) && local != was then :unrecorded
      elsif local != was && hash_of(from) != was then :both
      elsif local != was then :edited
      elsif hash_of(from) != was then :changed
      end
      [ path, state ]
    end
    (recorded.keys - source.keys).each { |path| states[path] = :removed }
    states.compact
  end

  def sync(modules)
    abort "Convention source not found at #{SOURCE}: write its folder's path to #{POINTER}." unless File.directory?(SOURCE)
    abort "Run sync from a project's root, not from the source." if File.expand_path(Dir.pwd) == SOURCE

    adopted = (ALWAYS + (lock&.fetch("modules") || []) + modules).uniq
    unknown = adopted - available_modules
    abort "Unknown module(s): #{unknown.join(", ")}. Available: #{available_modules.join(", ")}." if unknown.any?

    force = ENV["FORCE"] == "1"
    recorded = lock&.fetch("files") || {}
    files = source_files(adopted)

    # A copy edited here would be overwritten: stop, unless it's the first adoption with FORCE=1.
    conflicts = files.keys.select do |path|
      local = hash_of(path)
      local && local != hash_of(files[path]) && local != recorded[path]
    end
    if conflicts.any? && !force
      abort "These files differ from the source and weren't copied from it:\n" +
            conflicts.map { |path| "  #{path}" }.join("\n") +
            "\n\nMove what's worth keeping to the source (bin/convention upstream), or overwrite them with FORCE=1."
    end

    files.each do |path, from|
      next if hash_of(path) == hash_of(from)

      FileUtils.mkdir_p(File.dirname(path))
      FileUtils.cp(from, path)
      FileUtils.chmod(File.stat(from).mode & 0o777, path)
      puts "  copied #{path}"
    end
    (recorded.keys - files.keys).each do |path|
      if hash_of(path) == recorded[path]
        File.delete(path)
        puts "  removed #{path} (no longer in the source)"
      elsif File.exist?(path)
        puts "  kept #{path}: no longer in the source, but edited here"
      end
    end

    File.write(LOCK, <<~YAML + { "files" => files.keys.sort.to_h { |path| [ path, hash_of(path) ] } }.to_yaml.sub(/\A---\n/, ""))
      # Written by bin/convention sync; don't edit by hand.
      source: #{SOURCE.sub(Dir.home, "~")}
      commit: #{source_commit}
      modules: [#{adopted.join(", ")}]
    YAML
    puts "Convention synced (#{adopted.join(", ")}) at #{source_commit}."
  end

  def diff(paths)
    abort "Convention source not found at #{SOURCE}: write its folder's path to #{POINTER}." unless File.directory?(SOURCE)
    files = source_files(lock ? lock["modules"] : available_modules)
    paths = drift.keys if paths.empty? && lock
    paths.each do |path|
      from = files[path] or next puts("#{path}: not part of the convention")
      system("diff", "-u", "--label", "source/#{path}", "--label", path, from, path)
    end
  end

  def upstream(paths)
    abort "Convention source not found at #{SOURCE}: write its folder's path to #{POINTER}." unless File.directory?(SOURCE)
    abort "Name the files to copy back to the source." if paths.empty?
    files = source_files(lock ? lock["modules"] : available_modules)
    paths.each do |path|
      to = files[path] or abort "#{path} is not part of the convention."
      FileUtils.cp(path, to)
      puts "  #{path} -> #{to}"
    end
    puts "Now review and commit them in #{SOURCE}, then run `bin/convention sync` here and in the other projects."
  end

  # { "bin/check-links" => "<source>/modules/docs-checks/bin/check-links", ... }
  def source_files(modules)
    modules.flat_map do |name|
      root = File.join(SOURCE, "modules", name)
      Dir.glob("**/*", File::FNM_DOTMATCH, base: root)
         .reject { |path| File.directory?(File.join(root, path)) || File.basename(path).start_with?(".") }
         .map { |path| [ path, File.join(root, path) ] }
    end.to_h
  end

  def available_modules
    Dir.children(File.join(SOURCE, "modules")).sort
  end

  def lock
    @lock ||= File.exist?(LOCK) ? YAML.safe_load_file(LOCK) : nil
  end

  def hash_of(path)
    File.file?(path) ? Digest::SHA256.file(path).hexdigest[0, 16] : nil
  end

  def source_commit
    commit = `git -C #{SOURCE} rev-parse --short HEAD 2>/dev/null`.strip
    commit = "uncommitted" if commit.empty?
    dirty = !`git -C #{SOURCE} status --porcelain -- modules 2>/dev/null`.strip.empty?
    dirty ? "#{commit}+uncommitted" : commit
  end

  # `bin/convention archive <change> [--skip-specs]`: runs `openspec archive`, then does the
  # steps that need no judgment, and lists the ones that do.
  #   - Working on lines in docs/backlog.md that link the change are removed, and so are the
  #     bugs and cleanups they name (the change fixed them).
  #   - Links into the change follow it to openspec/changes/archive/<date>-<change>/; a link to
  #     its delta spec moves to the main spec it was merged into.
  #   - Links inside the moved change are rebased, since it now sits one folder deeper.
  #   - The checks run: openspec validate, docs:check, check-diagrams, check-links.
  # Left to the agent, and printed: the limitations the change moved (update or remove them),
  # and the change's diagrams that no feature's diagrams/ has a copy of.
  class Archive
    DOCS = [ "AGENTS.md", "openspec/**/*.md", "docs/**/*.md" ].freeze
    LINK = /\]\(([^)\s]+)\)/
    BACKLOG = "docs/backlog.md"
    CHECKS = [
      [ "openspec validate --specs --strict --no-interactive", -> { true } ],
      [ "bin/rails docs:check", -> { File.exist?("lib/tasks/docs.rake") } ],
      [ "bin/check-diagrams", -> { File.exist?("bin/check-diagrams") } ],
      [ "bin/check-links", -> { File.exist?("bin/check-links") } ]
    ].freeze

    def initialize(args)
      @flags = args.select { |arg| arg.start_with?("--") }
      @name = (args - @flags).first or abort "Usage: bin/convention archive <change> [--skip-specs]"
      @change = Pathname("openspec/changes/#{@name}")
    end

    def run
      abort "No change at #{@change}." unless @change.directory?
      uncopied = uncopied_diagrams
      system("openspec", "archive", @name, "--yes", *(@flags & [ "--skip-specs" ])) or
        abort "openspec archive failed; nothing else was changed."
      archived = Dir.glob("openspec/changes/archive/*-#{@name}").max or
        abort "openspec archive didn't leave #{@name} under openspec/changes/archive/."
      @archived = Pathname(archived)

      settled = settle_backlog
      rewritten = rewrite_links
      report(settled, rewritten, uncopied)
      exit(checks ? 0 : 1)
    end

    private

    # The flow, logic and lifecycle diagrams no feature's diagrams/ folder has a copy of.
    def uncopied_diagrams
      copied = Dir.glob("openspec/specs/**/diagrams/*.mmd").map { |path| File.basename(path) }
      Dir.glob(@change.join("diagrams/*.mmd").to_s).map { |path| File.basename(path) }
         .reject { |name| name == "data-model.mmd" || name == "files.mmd" || name.end_with?("-screen.mmd") }
         .reject { |name| copied.include?(name) }.sort
    end

    # Removes the change's Working on lines, and the bugs and cleanups they name.
    # Returns { limitations: [[title, link], ...], fixed: [title, ...] }.
    def settle_backlog
      settled = { limitations: [], fixed: [] }
      return settled unless File.exist?(BACKLOG)

      lines = File.readlines(BACKLOG)
      section = nil
      kept = lines.reject do |line|
        section = Regexp.last_match(1) if line =~ /\A## (.+?)\s*\z/
        next false unless section == "Working on" && line.include?("changes/#{@name}/")

        if (item = line.match(/\A\s*[-*]\s+\[([^\]]+)\]\(([^)]+)\)/))
          if item[2].match?(/\A#(bugs|cleanups)\z/)
            settled[:fixed] << item[1]
          else
            settled[:limitations] << [ item[1], item[2] ]
          end
        end
        true
      end
      section = nil
      kept = kept.reject do |line|
        section = Regexp.last_match(1) if line =~ /\A## (.+?)\s*\z/
        %w[Bugs Cleanups].include?(section) &&
          settled[:fixed].any? { |title| line.match?(/\A\s*[-*]\s+\*\*#{Regexp.escape(title)}\.?\*\*/) }
      end
      kept = note_empty_working_on(kept)
      File.write(BACKLOG, kept.join) unless kept == lines
      settled
    end

    def note_empty_working_on(lines)
      start = lines.index { |line| line.strip == "## Working on" } or return lines
      stop = lines.each_index.find { |i| i > start && lines[i].start_with?("## ") } || lines.size
      return lines if lines[(start + 1)...stop].any? { |line| line.strip != "" }

      lines[0..start] + [ "\n", "Nothing in progress.\n", "\n" ] + lines[stop..]
    end

    # Every relative link in the docs that pointed into the change now points into the archive
    # (or, for its delta spec, to the main spec); links inside the moved change are rebased.
    # Returns the files it rewrote.
    def rewrite_links
      root = Pathname.pwd
      DOCS.flat_map { |glob| Dir.glob(glob) }.uniq.filter_map do |path|
        file = Pathname(path)
        inside = file.to_s.start_with?("#{@archived}/")
        was = inside ? @change.join(file.relative_path_from(@archived)) : file
        text = file.read
        updated = text.gsub(LINK) do |match|
          target = Regexp.last_match(1)
          next match if target.match?(%r{\A(?:[a-z]+:|#|/)})

          target_path, anchor = target.split("#", 2)
          old = (root.join(was.dirname) + target_path).cleanpath.relative_path_from(root)
          new = retarget(old, inside)
          next match if new == old && !inside

          relative = new.relative_path_from(file.dirname).to_s
          relative += "/" if target_path.end_with?("/") && !relative.end_with?("/")
          relative = "#{relative}##{anchor}" if anchor
          "](#{relative})"
        end
        next if updated == text

        file.write(updated)
        path
      end
    end

    def retarget(old, inside)
      relative = old.to_s
      prefix = "#{@change}/"
      return old unless relative == @change.to_s || relative.start_with?(prefix)

      rest = relative.delete_prefix(@change.to_s).delete_prefix("/")
      if !inside && (spec = rest[%r{\Aspecs/(.+)/spec\.md\z}, 1]) && File.exist?("openspec/specs/#{spec}/spec.md")
        return Pathname("openspec/specs/#{spec}/spec.md")
      end

      rest.empty? ? @archived : @archived.join(rest)
    end

    def report(settled, rewritten, uncopied)
      puts "\nArchived to #{@archived}/."
      puts "Removed the change's Working on lines from #{BACKLOG}." if settled.values.any?(&:any?)
      settled[:fixed].each { |title| puts "  removed the fixed bug or cleanup \"#{title}\"" }
      rewritten.each { |path| puts "  rewrote links in #{path}" }

      todo = []
      settled[:limitations].each do |title, link|
        todo << "Update or remove the limitation \"#{title}\" (#{link.sub(%r{\A(\.\./)+}, "")}): the change moved it."
      end
      uncopied.each do |name|
        todo << "#{@archived}/diagrams/#{name} has no copy in a feature's diagrams/: copy it if it shows how the feature now works, and link it from implementation.md."
      end
      return if todo.empty?

      puts "\nLeft to you:"
      todo.each { |line| puts "  - #{line}" }
    end

    def checks
      puts
      CHECKS.select { |_, applies| applies.call }.map do |command, _|
        ok = system(command, out: File::NULL, err: File::NULL)
        puts "  #{ok ? "passed" : "FAILED"}: #{command}"
        ok
      end.all?
    end
  end
end

Convention.run(ARGV.first, ARGV.drop(1))
